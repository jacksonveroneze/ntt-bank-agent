{
  "Application": {
    "Name": "OrderAgent",
    "Version": "1.0.0"
  },
  "Serilog": {
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/metrics' or RequestPath like '/health' or RequestPath like '/favicon%'"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "Ai": {
    "Providers": {
      "Ollama": {
        "Enabled": true,
        "Model": "llama3.2:1b"
      },
      "Claude": {
        "Enabled": true,
        "Model": "claude-haiku-4-5"
      }
    },
    "Agents": {
      "Query": {
        "Provider": "Claude",
        "Model": "claude-haiku-4-5",
        "Temperature": 0
      }
    }
  }
}
