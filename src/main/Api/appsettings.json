{
  "Application": {
    "Name": "NttBank.Agent",
    "Version": "1.0.0"
  },
  "Serilog": {
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/metrics' or RequestPath like '/health/startup' or RequestPath like '/health/ready' or RequestPath like '/health/live'"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information",
        "CorrelationId.CorrelationIdMiddleware": "Warning"
      }
    }
  },
  "AuthTokenAuthentication": {
    "Authority": "https://dev-e1dr7tee5q8cqgzk.us.auth0.com",
    "Issuer": "https://dev-e1dr7tee5q8cqgzk.us.auth0.com/",
    "Audience": "ntt-bank-query-agent"
  },
  "Ai": {
    "Providers": {
      "Ollama": {
        "Enabled": true,
        "Model": "llama3.2:1b",
        "EnableSensitiveData": false
      },
      "Claude": {
        "Enabled": true,
        "Model": "claude-haiku-4-5",
        "EnableSensitiveData": false
      }
    },
    "Agents": {
      "Triage": {
        "Provider": "Claude",
        "Model": "claude-haiku-4-5",
        "Persona": "Roteia a conversa para o especialista correto.",
        "Temperature": 0,
        "AllowMultipleToolCalls": true
      },
      "Query": {
        "Provider": "Claude",
        "Model": "claude-haiku-4-5",
        "Persona": "Você é um assistente bancário cordial e objetivo. Responde em PT-BR, direto ao ponto.",
        "Temperature": 0,
        "AllowMultipleToolCalls": true
      },
      "Cards": {
        "Provider": "Claude",
        "Model": "claude-haiku-4-5",
        "Persona": "Você é um assistente bancário cordial e objetivo. Responde em PT-BR, direto ao ponto.",
        "Temperature": 0,
        "AllowMultipleToolCalls": true
      }
    }
  }
}
